<?xml version="1.0" encoding="UTF-8"?>
<launch>
    <!-- Глобальные аргументы симуляции (взяты из вашего uav_simulator.launch) -->
    <arg name="est" default="ekf2"/>
    <arg name="vehicle" default="iris"/>
    <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/iris_maze.world"/>
    <arg name="gui" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="verbose" default="true"/>
    <arg name="paused" default="false"/>

    <!-- 1. Запуск Gazebo со специальным миром лабиринта/препятствий -->
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="world_name" value="$(arg world)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="paused" value="$(arg paused)"/>
    </include>

    <!-- ==================================================================== -->
    <!-- 2. ГРУППОВОЙ СПАВН: 5 ДРОНОВ В РАЗНЫХ ПРОСТРАНСТВАХ ИМЕН (NAMESPACES) -->
    <!-- ==================================================================== -->

    <!-- ДРОН 0 -->
    <group ns="iris_0">
        <arg name="ID" value="0"/>
        <arg name="fcu_url" value="udp://:14540@localhost:14557"/>
        <include file="$(find px4)/launch/single_vehicle_spawn.launch">
            <arg name="x" value="0.0"/>
            <arg name="y" value="0.0"/>
            <arg name="z" value="0.0"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="mavlink_udp_port" value="14560"/>
            <arg name="mavlink_tcp_port" value="4560"/>
            <arg name="ID" value="$(arg ID)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>

    <!-- ДРОН 1 -->
    <group ns="iris_1">
        <arg name="ID" value="1"/>
        <arg name="fcu_url" value="udp://:14541@localhost:14559"/>
        <include file="$(find px4)/launch/single_vehicle_spawn.launch">
            <arg name="x" value="0.0"/>
            <arg name="y" value="1.5"/> <!-- Смещение по Y на 1.5 метра -->
            <arg name="z" value="0.0"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="mavlink_udp_port" value="14561"/>
            <arg name="mavlink_tcp_port" value="4561"/>
            <arg name="ID" value="$(arg ID)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>

    <!-- ДРОН 2 -->
    <group ns="iris_2">
        <arg name="ID" value="2"/>
        <arg name="fcu_url" value="udp://:14542@localhost:14561"/>
        <include file="$(find px4)/launch/single_vehicle_spawn.launch">
            <arg name="x" value="0.0"/>
            <arg name="y" value="3.0"/> <!-- Смещение по Y на 3 метра -->
            <arg name="z" value="0.0"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="mavlink_udp_port" value="14562"/>
            <arg name="mavlink_tcp_port" value="4562"/>
            <arg name="ID" value="$(arg ID)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>

    <!-- ДРОН 3 -->
    <group ns="iris_3">
        <arg name="ID" value="3"/>
        <arg name="fcu_url" value="udp://:14543@localhost:14563"/>
        <include file="$(find px4)/launch/single_vehicle_spawn.launch">
            <arg name="x" value="0.0"/>
            <arg name="y" value="-1.5"/> <!-- Смещение по Y в минус -->
            <arg name="z" value="0.0"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="mavlink_udp_port" value="14563"/>
            <arg name="mavlink_tcp_port" value="4563"/>
            <arg name="ID" value="$(arg ID)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>

    <!-- ДРОН 4 -->
    <group ns="iris_4">
        <arg name="ID" value="4"/>
        <arg name="fcu_url" value="udp://:14544@localhost:14565"/>
        <include file="$(find px4)/launch/single_vehicle_spawn.launch">
            <arg name="x" value="0.0"/>
            <arg name="y" value="-3.0"/> <!-- Смещение по Y в минус -->
            <arg name="z" value="0.0"/>
            <arg name="vehicle" value="$(arg vehicle)"/>
            <arg name="mavlink_udp_port" value="14564"/>
            <arg name="mavlink_tcp_port" value="4564"/>
            <arg name="ID" value="$(arg ID)"/>
        </include>
        <include file="$(find mavros)/launch/px4.launch">
            <arg name="fcu_url" value="$(arg fcu_url)"/>
            <arg name="tgt_system" value="$(eval 1 + arg('ID'))"/>
            <arg name="tgt_component" value="1"/>
        </include>
    </group>
</launch>
