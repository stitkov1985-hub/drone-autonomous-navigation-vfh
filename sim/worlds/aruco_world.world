<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="default">
    <!-- Global light source -->
    <include>
      <uri>model://sun</uri>
    </include>
    <!-- Ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>
    <!-- Реалистичная лесная трава и земля -->
    <include>
      <uri>model://grass_plane</uri>
    </include>

    <!-- НАСТОЯЩИЙ ОКЕАН НА КРАЮ ЛЕСА (Повернут на финиш по оси X) -->
    <include>
      <uri>model://ocean</uri>
      <pose>65 0 -0.1 0 0 0</pose>
    </include>

    <!-- ХАОТИЧНЫЕ РУЧНЫЕ ОБЪЕКТЫ И МУСОР НА ПУТИ ДРОНА -->
    <!-- Системный блок 1 (Стартовый) -->
    <model name='big_box_4'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.5 0.5 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <pose>2.0 1.5 0.4 0 0 0</pose>
    </model>
    <!-- Системный блок 2 (В глубине леса) -->
    <model name='forest_pc_2'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.5 0.5 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <pose>15.0 -3.0 0.4 0 0 0.5</pose>
    </model>
    <!-- Системный блок 3 (Ближе к океану) -->
    <model name='forest_pc_3'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.5 0.5 0.8</size></box></geometry></collision>
        <visual name='visual'><geometry><box><size>0.5 0.5 0.8</size></box></geometry><material><script><uri>file://media/materials/scripts/gazebo.material</uri><name>Gazebo/Grey</name></script></material></visual>
      </link>
      <pose>38.0 4.0 0.4 0 0 -0.7</pose>
    </model>

    <!-- Поддон 1 (Стартовый, опущен на -0.9, преграждает путь) -->
    <model name='pallet_full'>
      <static>1</static>
      <include><uri>model://pallet_full</uri></include>
      <pose>5.0 0.0 -0.9 0 0 1.57</pose>
    </model>
    <!-- Поддон 2 (В самой гуще) -->
    <model name='pallet_forest_2'>
      <static>1</static>
      <include><uri>model://pallet_full</uri></include>
      <pose>24.0 -1.0 -0.9 0 0 1.2</pose>
    </model>
    <!-- Поддон 3 (Перед выходом к океану) -->
    <model name='pallet_forest_3'>
      <static>1</static>
      <include><uri>model://pallet_full</uri></include>
      <pose>48.0 3.5 -0.9 0 0 -0.3</pose>
    </model>

