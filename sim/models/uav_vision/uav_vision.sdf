<?xml version="1.0" ?>
<sdf version='1.5'>
  <model name='uav_vision'>
    <include>
      <uri>model://iris</uri>
    </include>

    <!-- Дальномер смотрит вниз -->
    <include>
      <uri>model://rangefinder</uri>
      <pose>0 0 -0.04 0 0 0</pose>
    </include>

    <!-- Нижняя камера направлена вниз -->
    <include>
      <uri>model://navigation_cam</uri>
      <pose>0 0 -0.04 0 1.5708 0</pose>
      <cameraName>camera_down</cameraName>
      <frameName>camera_down_frame</frameName>
    </include>

    <joint name="range_down_joint" type="fixed">
      <child>rangefinder::link</child>
      <parent>iris::base_link</parent>
    </joint>

    <joint name="fpv_cam_joint" type="fixed">
      <child>navigation_cam::link</child>
      <parent>iris::base_link</parent>
      <pose>0 0 0 0 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <upper>0</upper>
          <lower>0</lower>
        </limit>
      </axis>
    </joint>

    <!-- Лидар возвращен в исходное горизонтальное положение -->
    <link name="laser_link">
      <pose>0.12 0 0.07 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>1e-6</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1e-6</iyy>
          <iyz>0</iyz>
          <izz>1e-6</izz>
        </inertia>
      </inertial>
      <sensor name="front_laser" type="ray">
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>10</update_rate>
        <pose>0 0 0 0 0 0</pose>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
            <vertical>
              <samples>5</samples>
              <resolution>1</resolution>
              <min_angle>-0.03</min_angle>
              <max_angle>0.03</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.25</min>
            <max>3.5</max>
            <resolution>0.02</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stdev>0.01</stdev>
          </noise>
        </ray>
        <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
          <topicName>/laser/scan</topicName>
          <frameName>laser_link</frameName>
          <robotNamespace>/</robotNamespace>
        </plugin>
      </sensor>
    </link>

    <joint name="laser_joint" type="fixed">
      <parent>iris::base_link</parent>
      <child>laser_link</child>
    </joint>
  </model>
</sdf>
